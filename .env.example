# Local-first runtime. Relative paths are resolved by the Windows scripts.
AERODIAGNOSIS_RUNTIME_DIR=.runtime
AERODIAGNOSIS_DATABASE_PATH=.runtime/data/aerodiagnosis.db
AERODIAGNOSIS_VECTOR_BACKEND=sqlite
AERODIAGNOSIS_GRAPH_BACKEND=sqlite
AERODIAGNOSIS_API_HOST=127.0.0.1
AERODIAGNOSIS_API_PORT=8080
AERODIAGNOSIS_SEED_DEMO_CONTENT=true

# Reserved for future write endpoints. Generate a random value; never commit it.
AERODIAGNOSIS_OPERATOR_TOKEN=

# Optional local demo provider. Copy this file to the git-ignored `.env.local` and fill these once
# to make the local UI ready without configuring every browser session. Never commit `.env.local`.
AERODIAGNOSIS_LLM_BASE_URL=
AERODIAGNOSIS_LLM_MODEL=
AERODIAGNOSIS_LLM_API_KEY=
# Alternative to placing the secret in this file:
AERODIAGNOSIS_LLM_API_KEY_FILE=

# Optional full deployment. SQLite remains authoritative; changes are replicated through the
# durable outbox and the aerodiagnosis-sync worker.
AERODIAGNOSIS_CHROMA_HOST=127.0.0.1
AERODIAGNOSIS_CHROMA_PORT=8000
AERODIAGNOSIS_CHROMA_SSL=false
AERODIAGNOSIS_CHROMA_COLLECTION=aerodiagnosis_chunks
AERODIAGNOSIS_NEO4J_URI=bolt://127.0.0.1:7687
AERODIAGNOSIS_NEO4J_USER=neo4j
AERODIAGNOSIS_NEO4J_PASSWORD=
AERODIAGNOSIS_NEO4J_DATABASE=neo4j
AERODIAGNOSIS_SYNC_BATCH_SIZE=50
AERODIAGNOSIS_SYNC_MAX_ATTEMPTS=12
