# Local-first runtime. Relative paths are resolved by the Windows scripts.
AERODIAGNOSIS_RUNTIME_DIR=.runtime
AERODIAGNOSIS_DATABASE_PATH=.runtime/data/aerodiagnosis.db
AERODIAGNOSIS_VECTOR_BACKEND=sqlite
AERODIAGNOSIS_GRAPH_BACKEND=sqlite
AERODIAGNOSIS_API_HOST=127.0.0.1
AERODIAGNOSIS_API_PORT=8080
AERODIAGNOSIS_SEED_DEMO_CONTENT=false

# Reserved for future write endpoints. Generate a random value; never commit it.
AERODIAGNOSIS_OPERATOR_TOKEN=

# Optional local demo provider. Copy this file to the git-ignored `.env.local` and fill these once
# to make the local UI ready without configuring every browser session. Never commit `.env.local`.
AERODIAGNOSIS_LLM_BASE_URL=
AERODIAGNOSIS_LLM_MODEL=
AERODIAGNOSIS_LLM_API_KEY=
# Alternative to placing the secret in this file:
AERODIAGNOSIS_LLM_API_KEY_FILE=

# Optional full deployment. SQLite remains authoritative; changes are replicated through the
# durable outbox and the aerodiagnosis-sync worker.
AERODIAGNOSIS_CHROMA_HOST=127.0.0.1
AERODIAGNOSIS_CHROMA_PORT=8000
AERODIAGNOSIS_CHROMA_SSL=false
AERODIAGNOSIS_CHROMA_COLLECTION=aerodiagnosis_chunks
AERODIAGNOSIS_NEO4J_URI=bolt://127.0.0.1:7687
AERODIAGNOSIS_NEO4J_USER=neo4j
AERODIAGNOSIS_NEO4J_PASSWORD=
AERODIAGNOSIS_NEO4J_DATABASE=neo4j
AERODIAGNOSIS_SYNC_BATCH_SIZE=50
AERODIAGNOSIS_SYNC_MAX_ATTEMPTS=12

# Knowledge engineering. Hashing is an offline research baseline.
AERODIAGNOSIS_KNOWLEDGE_PROFILE=research
AERODIAGNOSIS_KNOWLEDGE_CHUNKING=hierarchical
AERODIAGNOSIS_KNOWLEDGE_PARENT_BUDGET=3200
AERODIAGNOSIS_KNOWLEDGE_CHILD_BUDGET=600
AERODIAGNOSIS_MANUAL_RETRIEVAL=hybrid_rrf
AERODIAGNOSIS_MANUAL_CANDIDATE_K=50
AERODIAGNOSIS_MANUAL_RRF_K=60
AERODIAGNOSIS_MANUAL_MAX_PER_DOCUMENT=3
AERODIAGNOSIS_MANUAL_EXPAND_CONTEXT=true
# Production vector/hybrid requires an explicit trained embedding endpoint.
AERODIAGNOSIS_EMBEDDING_BACKEND=hashing

# Mature upstream integrations (install uv sync --extra upstream first).
AERODIAGNOSIS_KNOWLEDGE_PARSER=native
AERODIAGNOSIS_KNOWLEDGE_EXTRACTOR=lexical
# For Docling, point to a local HuggingFace tokenizer snapshot.
AERODIAGNOSIS_KNOWLEDGE_TOKENIZER_PATH=
# All ingestion and generation runs reuse this ledger; never reset it for a new run.
AERODIAGNOSIS_KNOWLEDGE_BUDGET_RUNTIME=.runtime/thesis-research-provider-v1
AERODIAGNOSIS_KNOWLEDGE_EXTRACTION_STAGE=corpus_graph
# Explicit cumulative ledger cap; raising a stage never raises this value automatically.
AERODIAGNOSIS_KNOWLEDGE_API_CAP_CNY=5

# Add Chinese display properties while keeping one graph and original evidence.
AERODIAGNOSIS_KNOWLEDGE_GRAPH_CHINESE_DISPLAY=false

# Verified Chinese-vector input requires local_e5 SQLite and an explicit full index rebuild.
AERODIAGNOSIS_EMBEDDING_INPUT_POLICY=source
AERODIAGNOSIS_MANUAL_VECTOR_WEIGHT=1
AERODIAGNOSIS_MANUAL_SPARSE_WEIGHT=1
# Optional source-grounded Neo4j candidates; 0 disables all graph candidate queries.
AERODIAGNOSIS_MANUAL_GRAPH_WEIGHT=0

# Optional directed source-backed paths; graph remains disabled when weight=0.
AERODIAGNOSIS_MANUAL_GRAPH_MODE=entity
